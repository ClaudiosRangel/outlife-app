# Supabase (obrigatório)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase Project ID (opcional, para CLI)
SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase Service Role Key (obrigatório, usada por src/integrations/supabase/client.server.ts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API (opcional, server-side apenas — sem prefixo VITE_)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Sentry — Error Monitoring Service (opcional, client + server)
SENTRY_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
VITE_SENTRY_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX

# SPA_Build_Target / Outlife_Native_Shell (opcional, apenas para build:native)
# VITE_BUILD_TARGET é injetada automaticamente pelo vite.config.ts a partir de
# BUILD_TARGET (não precisa ser definida manualmente aqui) — listada só como referência.
VITE_BUILD_TARGET=native-spa
# URL pública do SSR_Build_Target (Vercel), usada pelo shell nativo para chamar
# os endpoints HTTP que substituem as server functions do TanStack Start.
VITE_API_BASE_URL=https://outlife-app.vercel.app
# Chave pública VAPID usada por push-registration.ts para assinar
# Web_Push_Subscription (navigator.serviceWorker + PushManager), fora do
# Outlife_Native_Shell.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
